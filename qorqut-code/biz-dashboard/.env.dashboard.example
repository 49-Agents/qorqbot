# biz-dashboard machine config. Copy to .env.dashboard (gitignored) and fill in.
# Read by start.sh: HOST/PORT become --host/--port; INTERPRETER, WORKSPACE, INSTANCE_ROOT and COMPONENT_* become
# the host's explicit launch arguments (never environment); the rest is the dashboard's environment.
# Every selection below is required and must be an absolute, normalized path. Nothing is discovered: no sibling
# checkout, default interpreter or businesses root is searched, and BIZ_ROOT/BIZ_DIRS are retired.
HOST=127.0.0.1                 # Private dashboard; remote browser addresses require explicit origins
PORT=1049
INTERPRETER=/home/you/qorqut/host/.venv/bin/python   # The installed host's Python (not needed with BIZ_DASH_LAUNCHER)
WORKSPACE=/home/you/qorqut                 # Protected configuration and package-source workspace
INSTANCE_ROOT=/home/you/qorqut/instance    # Holds operations/ (the one database and working material) and qorqut-roles/
COMPONENT_APP=/home/you/qorqut/qorqut-code/app
COMPONENT_DASHBOARD=/home/you/qorqut/qorqut-code/biz-dashboard
#COMPONENT_OPERATIONS_ENGINE=/home/you/qorqut/qorqut-code/qorqut-operations
#COMPONENT_CONTEXT_ENGINE=/home/you/qorqut/qorqut-code/qorqut-context
#COMPONENT_ROLES=/home/you/qorqut/qorqut-roles/agent-roles   # Reusable role sources, separate from every code component
QORQUT_TERMINAL_WORKSPACE=/home/you/qorqut  # Stable utility-shell root, never a release directory
BIZ_SERVICE_ORIGINS=http://127.0.0.1:1049,http://localhost:1049
BAZARLYK_MCP_URL=http://127.0.0.1:1049/mcp
# Owner consent required before enabling; applies when an agent is next prepared.
BAZARLYK_CAPTURE_TRANSCRIPTS=false  # Exact own-session snapshots for learnings, never a transcript scan
DEEPSEEK_API_KEY=sk-...        # Fixed filing, summary, map and learning programs
#BIZ_BACKGROUND_MODEL=deepseek-v4-flash

# Optional service Fleet fallback. Business-owned FLEET_API_URL/FLEET_API_TOKEN take precedence.
#BIZ_SERVICE_URL=http://your-fleet-service:8787
#BIZ_SERVICE_TOKEN=replace-with-the-service-credential

# Routine definitions and worker identity are registered in SQLite, not configured as shell commands.
# Startup does not create schedules or run nightly maintenance.
