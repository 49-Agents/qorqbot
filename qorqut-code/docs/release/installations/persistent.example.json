  "origin": "http://qorqut.example:1071",
  "service": "qorqut-dashboard.service",
  "extras": [
    "service"
  ],
  "checks": {},
  "health_timeout": 5,
  "drain_timeout": 2,
  "registrations": [],
  "reference_files": [],
