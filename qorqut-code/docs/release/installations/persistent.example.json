  "service_user": "qorqut",
  "service_environment": {
    "PATH": "/absolute/path/to/node/bin:/absolute/path/to/qorqut/bin:/usr/local/bin:/usr/bin:/bin"
  },
  "execution_targets": [],
  "extensions": []
