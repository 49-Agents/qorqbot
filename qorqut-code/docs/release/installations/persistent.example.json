{
  "format": 1,
  "root": "/absolute/path/to/qorqut",
  "businesses_root": "/absolute/path/to/businesses",
  "database": "/absolute/path/to/businesses/.bazarlyk/state.sqlite3",
  "private_config": "/absolute/path/to/qorqut/config/dashboard.env",
  "package_sources": "/absolute/path/to/qorqut/config/package-sources.json",
  "browser_runtime": "/absolute/path/to/qorqut/runtime/browser/<verified-existing-runtime>",
