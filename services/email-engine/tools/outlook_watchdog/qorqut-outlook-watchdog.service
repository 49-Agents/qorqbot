[Unit]
Description=Check the Outlook bridge and recover a frozen browser
After=bazarlyk-email-engine.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=qorqut-outlook-watchdog
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 -I @INSTALL_DIR@/watchdog.py
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/qorqut-email
ProtectKernelTunables=yes
ProtectControlGroups=yes
